# =============================================================================
# algo_3kings_long_hl — 環境變數
# 將下列必填項改成你自己的值；切勿把填好真實私鑰的 .env 提交到 Git。
# =============================================================================

# --- Hyperliquid（必填，程式啟動會檢查）---
# 公開錢包地址，例如 0x 開頭
HL_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# 交易用私鑰（Hex，通常 64 個 hex 字元；是否含 0x 前綴依你錢包匯出格式為準）
HL_PRIVATE_KEY=YOUR_PRIVATE_KEY_HEX_HERE

# --- Simulation（選填）---
# true = 模擬倉位與餘額，行情仍來自 Hyperliquid 公開 API
SIMULATION_MODE=true

# 模擬起始資金（USDC）
SIM_BALANCE=1000

# --- 選填（若省略則使用 algo_3kings_long_hl.py 內建預設）---
# Telegram：設為 true 且具備 telegram_bot 模組時才發送通知（預設不發送）
# ENABLE_TELEGRAM_SEND=false

# FEE_RATE=0.000389
# FEE_RATE_MAKER=0.000130
# MIN_VOLUME_USDC=5000000
# MAX_SCOUT_CHANGE_PCT=20.0
# HEARTBEAT_FILE=/tmp/algo_3kings_hl.heartbeat

# --- V5-EV strategy tuning (default values shown; uncomment to override) ---
# TP_ATR_MULT=1.5             # take-profit multiplier (× ATR); 1.5×ATR
# SL_ATR_MULT=1.0             # stop-loss multiplier (× ATR); 1.0×ATR
# NET_FLOW_SIGMA=1.0          # Lee-Ready z-score gate (lower = more entries)
# MAX_5MIN_PUMP_PCT=0.003     # BTC anti-peak: block if 5m pump > 0.3%
# MAX_30MIN_PUMP_PCT=0.015    # BTC anti-chase: block if 30m pump > 1.5%
# MAX_5MIN_PUMP_SYM=0.008     # symbol anti-peak: block if 5m pump > 0.8%
